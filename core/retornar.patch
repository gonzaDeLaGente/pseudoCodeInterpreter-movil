+// pseint-movil: busca en el cuerpo de la función (desde la línea siguiente a la
+// cabecera) un RETORNAR seguido de una expresión
+static bool TieneRetornarConValor(int linea) {
+	for (int i=linea+1;i<programa.GetSize();i++) {
+		string s=programa[i].instruccion;
+		string fw=FirstWord(s); FixAcentos(fw);
+		if (fw=="FINFUNCION"||fw=="FINSUBPROCESO"||fw=="FINSUBALGORITMO"||fw=="FUNCION"||
+			fw=="SUBPROCESO"||fw=="SUBALGORITMO"||fw=="PROCESO"||fw=="ALGORITMO") return false;
+		int l=s.size();
+		for (int j=0;j<l;j++) {
+			if (s[j]=='\'') { while (++j<l && s[j]!='\''); continue; }
+			if (s.compare(j,8,"RETORNAR")!=0) continue;
+			if ((j>0 && parteDePalabra(s[j-1])) || (j+8<l && parteDePalabra(s[j+8]))) continue;
+			int k=j+8; while (k<l && s[k]==' ') k++;
+			if (k>=l || s[k]==';') continue;
+			string next=FirstWord(s.substr(k)); FixAcentos(next);
+			if (next=="FINSI"||next=="SINO"||next=="FINMIENTRAS"||next=="FINPARA"||next=="FINSEGUN"||
+				next=="HASTA"||next=="MIENTRAS"||next=="FINFUNCION"||next=="FINSUBPROCESO"||
+				next=="FINSUBALGORITMO"||next=="FIN") continue;
+			return true;
+		}
+	}
+	return false;
+}
